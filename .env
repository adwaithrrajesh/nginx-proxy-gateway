# Nginx Proxy Gateway Configuration

# Domains (space separated for multiple domains)
DOMAINS="admin.google.com example.google.com"

# Email for Let's Encrypt certificates
CERT_EMAIL="example@gmail.com"

# Staging mode (1 for testing, 0 for production)
STAGING=1

# Docker resource limits
MEM_LIMIT=512M
CPU_LIMIT=0.5